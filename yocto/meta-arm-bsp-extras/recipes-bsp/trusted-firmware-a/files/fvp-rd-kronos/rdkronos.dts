	memory@80000000 {
		device_type = "memory";
		/*
		 * 0x7fc0 0000 - 0x7fff ffff : BL32
		 * 0x7fbf 0000 - 0x7fbf ffff : FFA_SHARED_MM_BUF
		 */
		reg = <0x00000000 0x80000000 0 0x7fbf0000>,
			  <0x00000080 0x80000000 0x00000003 0x80000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		si_c0_rproc_rsctbl: rsctbl@40000000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x40000000 0x0 0x1000>;
			no-map;
		};

		si_c0_vdev0vring0: vdev0vring0@40001000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x40001000 0x0 0x100000>;
			no-map;
		};

		si_c0_vdev0vring1: vdev0vring1@40101000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x40101000 0x0 0x100000>;
			no-map;
		};

		si_c0_vdev0buffer: vdev0buffer@40201000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x40201000 0x0 0x300000>;
			no-map;
		};

		si_c1_rproc_rsctbl: rsctbl@40501000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x40501000 0x0 0x1000>;
			no-map;
		};

		si_c1_vdev0vring0: vdev0vring0@40502000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x40502000 0x0 0x100000>;
			no-map;
		};

		si_c1_vdev0vring1: vdev0vring1@40602000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x40602000 0x0 0x100000>;
			no-map;
		};

		si_c1_vdev0buffer: vdev0buffer@40702000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x40702000 0x0 0x300000>;
			no-map;
		};

		si_c2_rproc_rsctbl: rsctbl@40a02000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x40a02000 0x0 0x1000>;
			no-map;
		};

		si_c2_vdev0vring0: vdev0vring0@40a03000 {
