	SLC: cache-controller {
		compatible = "arm,slc", "cache";
		cache-level = <0x03>;
		cache-unified;
		cache-line-size = <0x40>;
		cache-sets = <0x8000>;
		cache-size = <0x2000000>;
		#address-cells = <0x02>;
		#size-cells = <0x01>;

		msc@102601000 {
			compatible = "arm,mpam-msc";
			reg = <0x01 0x2601000 0x3000>;
			arm,not-ready-us = <0x10>;
		};

		msc@102641000 {
			compatible = "arm,mpam-msc";
			reg = <0x01 0x2641000 0x3000>;
			arm,not-ready-us = <0x10>;
		};

		msc@104601000 {
			compatible = "arm,mpam-msc";
			reg = <0x01 0x4601000 0x3000>;
			arm,not-ready-us = <0x10>;
		};

		msc@104641000 {
			compatible = "arm,mpam-msc";
			reg = <0x01 0x4641000 0x3000>;
			arm,not-ready-us = <0x10>;
		};

		msc@106601000 {
