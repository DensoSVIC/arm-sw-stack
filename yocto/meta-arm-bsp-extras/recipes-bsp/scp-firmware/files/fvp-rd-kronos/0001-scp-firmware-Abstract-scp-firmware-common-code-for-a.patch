diff --git a/product/rdfremont/mcp_ramfw/CMakeLists.txt b/product/rdfremont/mcp_ramfw/CMakeLists.txt
new file mode 100644
index 000000000..fe7d069c4
--- /dev/null
+++ b/product/rdfremont/mcp_ramfw/CMakeLists.txt
@@ -0,0 +1,63 @@
+#
+# Arm SCP/MCP Software
+# Copyright (c) 2023, Arm Limited and Contributors. All rights reserved.
+#
+# SPDX-License-Identifier: BSD-3-Clause
+#
+
+#
+# Create the firmware target.
+#
+
+add_executable(rdfremont-mcp-bl2)
+
+# SCP_PLATFORM_VARIANT value for supported RD-Fremont platform variants:
+# - '0' for RD-Fremont platform
+# - '1' for RD-Fremont-Cfg1 platform
+# - '2' for RD-Fremont-Cfg2 platform
+
+if (SCP_PLATFORM_VARIANT STREQUAL "0")
+      target_compile_definitions(rdfremont-mcp-bl2
+                                 PUBLIC -DPLATFORM_VARIANT=0)
+elseif (SCP_PLATFORM_VARIANT STREQUAL "1")
+      target_compile_definitions(rdfremont-mcp-bl2
+                                 PUBLIC -DPLATFORM_VARIANT=1)
+elseif (SCP_PLATFORM_VARIANT STREQUAL "2")
+      target_compile_definitions(rdfremont-mcp-bl2
+                                 PUBLIC -DPLATFORM_VARIANT=2)
+else()
+      message(FATAL_ERROR "Please set SCP_PLATFORM_VARIANT to \n"
+                                "'0' for RD-Fremont\n"
+                                "'1' for RD-Fremont-Cfg1\n"
+                                "'2' for RD-Fremont-Cfg2\n")
+endif()
+
+target_include_directories(
+    rdfremont-mcp-bl2 PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/../include"
+                    "${CMAKE_CURRENT_SOURCE_DIR}"
+                    "${CMAKE_CURRENT_SOURCE_DIR}/include")
+
+# cmake-lint: disable=E1122
+
+target_sources(
+    rdfremont-mcp-bl2
+    PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/config_armv7m_mpu.c"
+            "${CMAKE_CURRENT_SOURCE_DIR}/config_clock.c"
+            "${CMAKE_CURRENT_SOURCE_DIR}/config_pl011.c"
+            "${CMAKE_CURRENT_SOURCE_DIR}/config_timer.c"
+            "${CMAKE_CURRENT_SOURCE_DIR}/config_gtimer.c")
+
+#
+# Some of our firmware includes require CMSIS.
+#
+
+target_link_libraries(rdfremont-mcp-bl2 PUBLIC cmsis::core-m)
+
+#
+# We explicitly add the CMSIS include directories to our interface include
+# directories. Each module target adds these include directories to their own,
+# allowing them to include any firmware includes we expose.
+#
+
+target_include_directories(rdfremont-mcp-bl2
+    PUBLIC $<TARGET_PROPERTY:cmsis::core-m,INTERFACE_INCLUDE_DIRECTORIES>)
diff --git a/product/rdfremont/mcp_ramfw/Firmware.cmake b/product/rdfremont/mcp_ramfw/Firmware.cmake
