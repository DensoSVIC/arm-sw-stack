+        ((uint64_t)raid << (ldid_value_offset * NUM_BITS_RESERVED_FOR_RAID));
+
+    /* Set corresponding valid bit */
+    ccg_ra_reg->CCG_RA_RND_LDID_TO_EXP_RAID_REG[register_offset] |=
