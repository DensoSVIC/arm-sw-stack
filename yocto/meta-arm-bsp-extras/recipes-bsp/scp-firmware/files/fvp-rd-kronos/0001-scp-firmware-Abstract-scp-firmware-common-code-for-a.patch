+
+static void program_hns_ldid_to_rn_nodeid(
+    const struct mod_cmn_cyprus_ccg_config *ccg_config)
+{
+    uint8_t linkid = 0;
+    unsigned int remote_rnf_ldid_value;
+
+    remote_rnf_ldid_value =
+        (ccg_config->remote_chip_id[linkid] * shared_ctx->rnf_count);
