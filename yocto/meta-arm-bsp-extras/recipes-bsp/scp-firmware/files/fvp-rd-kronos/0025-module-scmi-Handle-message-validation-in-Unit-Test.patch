 typedef struct _CMOCK_mod_scmi_from_protocol_notify_CALL_INSTANCE
 {
   UNITY_LINE_TYPE LineNumber;
@@ -457,6 +488,12 @@ static struct Mockmod_scmi_extraInstance
   CMOCK_mod_scmi_from_protocol_respond_CALLBACK mod_scmi_from_protocol_respond_CallbackFunctionPointer;
   int mod_scmi_from_protocol_respond_CallbackCalls;
   CMOCK_MEM_INDEX_TYPE mod_scmi_from_protocol_respond_CallInstance;
+  char mod_scmi_from_protocol_scmi_message_validation_IgnoreBool;
+  int mod_scmi_from_protocol_scmi_message_validation_FinalReturn;
+  char mod_scmi_from_protocol_scmi_message_validation_CallbackBool;
+  CMOCK_mod_scmi_from_protocol_scmi_message_validation_CALLBACK mod_scmi_from_protocol_scmi_message_validation_CallbackFunctionPointer;
+  int mod_scmi_from_protocol_scmi_message_validation_CallbackCalls;
+  CMOCK_MEM_INDEX_TYPE mod_scmi_from_protocol_scmi_message_validation_CallInstance;
   char mod_scmi_from_protocol_notify_IgnoreBool;
   char mod_scmi_from_protocol_notify_CallbackBool;
   CMOCK_mod_scmi_from_protocol_notify_CALLBACK mod_scmi_from_protocol_notify_CallbackFunctionPointer;
@@ -682,6 +719,19 @@ void Mockmod_scmi_extra_Verify(void)
     call_instance = CMOCK_GUTS_NONE;
     (void)call_instance;
   }
+  call_instance = Mock.mod_scmi_from_protocol_scmi_message_validation_CallInstance;
+  if (Mock.mod_scmi_from_protocol_scmi_message_validation_IgnoreBool)
+    call_instance = CMOCK_GUTS_NONE;
+  if (CMOCK_GUTS_NONE != call_instance)
+  {
+    UNITY_SET_DETAIL(CMockString_mod_scmi_from_protocol_scmi_message_validation);
+    UNITY_TEST_FAIL(cmock_line, CMockStringCalledLess);
+  }
+  if (Mock.mod_scmi_from_protocol_scmi_message_validation_CallbackFunctionPointer != NULL)
