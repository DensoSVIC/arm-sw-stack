+  Mock.mod_scmi_from_protocol_scmi_message_validation_IgnoreBool = (char)0;
+  cmock_call_instance->LineNumber = cmock_line;
+  cmock_call_instance->ExpectAnyArgsBool = (char)0;
+  cmock_call_instance->ReturnVal = cmock_to_return;
+  Mock.mod_scmi_from_protocol_scmi_message_validation_IgnoreBool = (char)1;
+}
