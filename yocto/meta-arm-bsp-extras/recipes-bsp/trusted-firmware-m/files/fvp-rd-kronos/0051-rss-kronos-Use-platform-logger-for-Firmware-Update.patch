     current_state = get_fwu_agent_state(&fwu_md_rss, &priv_metadata);
 
     if (current_state == FWU_AGENT_STATE_TRIAL) {
-        FWU_LOG_MSG("%s: in trial state, starting host ack timer\n\r",
