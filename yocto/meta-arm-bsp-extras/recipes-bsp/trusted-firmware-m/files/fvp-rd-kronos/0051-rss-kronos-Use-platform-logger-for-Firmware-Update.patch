+        ERROR("%s: Bank offset is not a multiple of sector size", __func__);
         return FWU_AGENT_ERROR;
     }
 
     if ((BANK_PARTITION_SIZE % FWU_METADATA_FLASH_SECTOR_SIZE) != 0) {
