         }
     }
 
-    FWU_LOG_MSG("%s: exit\n\r", __func__);
+    DEBUG("%s: exit", __func__);
     return;
 }
diff --git a/platform/ext/target/arm/rss/kronos/fw_update_agent/fwu_agent.h b/platform/ext/target/arm/rss/kronos/fw_update_agent/fwu_agent.h
