+    roba_value = ATU_ROBA_SET_0;
+    atu_err = set_axnsc(&ATU_DEV_S, roba_value, HOST_SYSCTRL_TOWER_NCI_ATU_ID);
+    if (atu_err != ATU_ERR_NONE) {
