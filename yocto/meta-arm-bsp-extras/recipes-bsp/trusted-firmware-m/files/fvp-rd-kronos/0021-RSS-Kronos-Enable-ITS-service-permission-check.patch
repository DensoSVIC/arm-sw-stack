From a000b4e5e3ada7cba7f29b8bf489f47bbc13bd26 Mon Sep 17 00:00:00 2001
From: Ziad Elhanafy <ziad.elhanafy@arm.com>
Date: Wed, 11 Oct 2023 11:44:27 +0100
Subject: [PATCH] RSS: Kronos: Enable ITS service permission check

Enable Internal Trusted Storage service permission check
to be able to use the ITS service.

Upstream-Status: Pending
Signed-off-by: Ziad Elhanafy <ziad.elhanafy@arm.com>
---
 .../kronos/rss_comms/rss_comms_permissions_hal.c  | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/platform/ext/target/arm/rss/kronos/rss_comms/rss_comms_permissions_hal.c b/platform/ext/target/arm/rss/kronos/rss_comms/rss_comms_permissions_hal.c
index 126691099..d2a8c82d9 100644
--- a/platform/ext/target/arm/rss/kronos/rss_comms/rss_comms_permissions_hal.c
+++ b/platform/ext/target/arm/rss/kronos/rss_comms/rss_comms_permissions_hal.c
@@ -28,6 +28,9 @@
 #ifdef TFM_PARTITION_PROTECTED_STORAGE
 #include "tfm_ps_defs.h"
 #endif /* TFM_PARTITION_PROTECTED_STORAGE */
+#ifdef TFM_PARTITION_INTERNAL_TRUSTED_STORAGE
+#include "tfm_its_defs.h"
+#endif /* TFM_PARTITION_INTERNAL_TRUSTED_STORAGE */
 
 
 #define INVALID_REGION_COUNTER_MAX  128
@@ -171,6 +174,18 @@ enum tfm_plat_err_t comms_permissions_service_check(psa_handle_t handle,
             goto out_err;
         }
 #endif /* TFM_PARTITION_PROTECTED_STORAGE */
+#ifdef TFM_PARTITION_INTERNAL_TRUSTED_STORAGE
+    case TFM_INTERNAL_TRUSTED_STORAGE_SERVICE_HANDLE:
+        switch (type) {
+        case TFM_ITS_SET:
+        case TFM_ITS_GET:
+        case TFM_ITS_GET_INFO:
+        case TFM_ITS_REMOVE:
+            return TFM_PLAT_ERR_SUCCESS;
+        default:
+            goto out_err;
+        }
+#endif /* TFM_PARTITION_INTERNAL_TRUSTED_STORAGE */
 
     default:
         goto out_err;
-- 
2.25.1

