+/* MHUv3 frame type */
+union _mhu_v3_x_frame_t {
+    /* Postbox Frame */
+    struct _mhu_v3_x_pbx pbx_frame;
+    /* Mailbox Frame */
+    struct _mhu_v3_x_mbx mbx_frame;
+};
