+        *exec_ram_start = NS_IMAGE_LOAD_ADDRESS;
+        *exec_ram_size  = NON_SECURE_IMAGE_MAX_SIZE;
+        rc = 0;
+    } else if (image_id == RSS_FIRMWARE_SCP_ID) {
