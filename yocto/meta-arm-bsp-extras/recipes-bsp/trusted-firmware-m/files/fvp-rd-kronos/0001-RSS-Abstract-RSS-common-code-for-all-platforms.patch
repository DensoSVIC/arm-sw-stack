-
-    limit_cfg |= MPU_RLAR_EN_Msk;
-
-    mpu->RLAR = limit_cfg;
-
-    /*Restore main MPU control*/
-    mpu->CTRL = ctrl_before;
-
-    /* Enable MPU before the next instruction */
-    __DSB();
-    __ISB();
-
-    return ret_val;
-}
