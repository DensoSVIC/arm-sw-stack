+    /* Close RSS ATU region configured to access SI CL1 SRAM code region */
+    atu_err = atu_uninitialize_region(&ATU_DEV_S, HOST_SI_CL1_IMG_CODE_ATU_ID);
+    if (atu_err != ATU_ERR_NONE) {
+        return 1;
+    }
+
+    BOOT_LOG_INF("BL2: SI CL1 post load complete");
+
+    return 0;
+}
