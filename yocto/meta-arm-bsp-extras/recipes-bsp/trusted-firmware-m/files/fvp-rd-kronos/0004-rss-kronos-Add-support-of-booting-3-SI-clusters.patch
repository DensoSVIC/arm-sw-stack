+    /* Close RSS ATU region configured to access RSS header region for SI CL1 */
+    atu_err = atu_uninitialize_region(&ATU_DEV_S, HOST_SI_CL1_IMG_HDR_ATU_ID);
+    if (atu_err != ATU_ERR_NONE) {
+        return 1;
