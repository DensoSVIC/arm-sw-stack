diff --git a/platform/ext/target/arm/rss/kronos/firmware_image_id.h b/platform/ext/target/arm/rss/kronos/firmware_image_id.h
new file mode 100644
index 000000000..497d3bf90
--- /dev/null
+++ b/platform/ext/target/arm/rss/kronos/firmware_image_id.h
@@ -0,0 +1,27 @@
