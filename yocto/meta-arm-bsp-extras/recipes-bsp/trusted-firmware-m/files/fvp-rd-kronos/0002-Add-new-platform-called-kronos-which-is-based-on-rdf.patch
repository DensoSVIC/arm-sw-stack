+static struct uart_pl011_dev_data_t RSS_UART0_PL011_DEV_DATA_S = {
+    .state = 0,
+    .uart_clk = 0,
+    .baudrate = 0};
+struct uart_pl011_dev_t RSS_UART0_PL011_DEV_S = {
+    &(RSS_UART0_PL011_DEV_CFG_S),
+    &(RSS_UART0_PL011_DEV_DATA_S)};
