     [RSS_FIRMWARE_SI_CL1_ID]        = boot_platform_post_load_si_cl1,
@@ -1110,6 +1019,7 @@ static int (*boot_platform_post_load_vector[RSS_FIRMWARE_COUNT]) (void) = {
