     [RSS_FIRMWARE_NON_SECURE_ID]    = boot_platform_post_load_non_secure,
     [RSS_FIRMWARE_SCP_ID]           = boot_platform_post_load_scp,
-    [RSS_FIRMWARE_MCP_ID]           = boot_platform_post_load_mcp,
