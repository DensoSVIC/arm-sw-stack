+	)
+endif()
diff --git a/platform/drivers/arm/mhu_driver/mhu.h b/platform/drivers/arm/mhu_driver/mhu.h
new file mode 100644
index 0000000..e9f407b
--- /dev/null
+++ b/platform/drivers/arm/mhu_driver/mhu.h
@@ -0,0 +1,107 @@
+/*
