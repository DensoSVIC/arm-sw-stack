From 51604e4bc4d788c759fbf1b437214aea92e7bb03 Mon Sep 17 00:00:00 2001
From: Jiamei Xie <jiamei.xie@arm.com>
Date: Wed, 16 Aug 2023 15:47:01 +0800
Subject: [PATCH] core:arm: Reduce the OPTEE ram size to 4M for rdkronos

32M is too large. Change the size to 4M.

Upstream-Status: Pending [Not submitted to upstream yet]
Signed-off-by: Jiamei Xie <jiamei.xie@arm.com>
---
 core/arch/arm/plat-rdkronos/conf.mk | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/core/arch/arm/plat-rdkronos/conf.mk b/core/arch/arm/plat-rdkronos/conf.mk
index ae81c9f4c..69f924361 100644
--- a/core/arch/arm/plat-rdkronos/conf.mk
+++ b/core/arch/arm/plat-rdkronos/conf.mk
@@ -25,6 +25,6 @@ CFG_CORE_HEAP_SIZE = 0x32000
 
 CFG_TEE_CORE_NB_CORE ?= 16
 
-CFG_TZDRAM_START ?= 0xfe000000
-CFG_TZDRAM_SIZE  ?= 0x02000000
+CFG_TZDRAM_START ?= 0xffc00000
+CFG_TZDRAM_SIZE  ?= 0x00400000
 
-- 
2.25.1

