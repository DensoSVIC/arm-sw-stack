[Unit]
Description=Arm Automotive Solutions Open vSwitch network configuration
After=openvswitch.service
PartOf=network.target
Requires=openvswitch.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/arm-auto-solutions-ovs.sh start
ExecReload=/usr/sbin/arm-auto-solutions-ovs.sh reload
ExecStop=/usr/sbin/arm-auto-solutions-ovs.sh stop
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
