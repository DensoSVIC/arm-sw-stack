From 163b115bcaf3d0482fa0288ae6d39bbb57ed9142 Mon Sep 17 00:00:00 2001
From: Jiamei Xie <jiamei.xie@arm.com>
Date: Tue, 7 Nov 2023 16:26:32 +0800
Subject: [PATCH] tests/zephyr-mbedtls: Make asymmetric operations to call
 rss driver

Set key location for all asymmetric related operations to call rss
driver.

The below test suites are modifed:

test_c016 (psa_generate_key, RSA cases only)
test_c050 (psa_sign_message)
test_c051 (psa_verify_message)
test_c041 (psa_sign_hash)
test_c042 (psa_verify_hash)
test_c039 (psa_asymmetric_encrypt)
test_c040 (psa_asymmetric_decrypt)

Upstream-Status: Inappropriate [Kronos-specific]
Signed-off-by: Jiamei Xie <jiamei.xie@arm.com>
---
 api-tests/dev_apis/crypto/test_c016/test_c016.c | 11 +++++++++++
 api-tests/dev_apis/crypto/test_c039/test_c039.c |  5 +++++
 api-tests/dev_apis/crypto/test_c040/test_c040.c |  5 +++++
 api-tests/dev_apis/crypto/test_c041/test_c041.c |  4 ++++
 api-tests/dev_apis/crypto/test_c042/test_c042.c |  4 ++++
 api-tests/dev_apis/crypto/test_c050/test_c050.c |  3 +++
 api-tests/dev_apis/crypto/test_c051/test_c051.c |  4 ++++
 7 files changed, 36 insertions(+)

diff --git a/api-tests/dev_apis/crypto/test_c016/test_c016.c b/api-tests/dev_apis/crypto/test_c016/test_c016.c
index cde0940..17237e3 100644
--- a/api-tests/dev_apis/crypto/test_c016/test_c016.c
+++ b/api-tests/dev_apis/crypto/test_c016/test_c016.c
@@ -26,6 +26,8 @@ const client_test_t test_c016_crypto_list[] = {
     NULL,
 };
 
+#define PSA_KEY_LOCATION_RSS                ((psa_key_location_t) 0x800000)
+
 int32_t psa_generate_key_test(caller_security_t caller __UNUSED)
 {
     int32_t               i, status;
@@ -65,6 +67,15 @@ int32_t psa_generate_key_test(caller_security_t caller __UNUSED)
         val->crypto_function(VAL_CRYPTO_SET_KEY_USAGE_FLAGS, &attributes, check1[i].usage_flags);
         val->crypto_function(VAL_CRYPTO_SET_KEY_ALGORITHM,   &attributes, check1[i].alg);
 
+#ifdef ARCH_TEST_ASYMMETRIC_ENCRYPTION
+        if (check1[i].type == PSA_KEY_TYPE_RSA_KEY_PAIR || check1[i].type == PSA_KEY_TYPE_RSA_PUBLIC_KEY)
+            val->crypto_function(VAL_CRYPTO_SET_KEY_LIFETIME, &attributes,
+                                 PSA_KEY_LIFETIME_FROM_PERSISTENCE_AND_LOCATION(
+                                 PSA_KEY_PERSISTENCE_VOLATILE,
+                                 PSA_KEY_LOCATION_RSS));
+#endif
+
+
         /* Generate the key */
         status = val->crypto_function(VAL_CRYPTO_GENERATE_KEY, &attributes, &key);
         TEST_ASSERT_EQUAL(status, check1[i].expected_status, TEST_CHECKPOINT_NUM(3));
