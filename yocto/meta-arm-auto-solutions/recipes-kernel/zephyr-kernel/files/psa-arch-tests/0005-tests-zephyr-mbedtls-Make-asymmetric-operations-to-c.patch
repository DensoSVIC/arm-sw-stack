+++ b/api-tests/dev_apis/crypto/test_c039/test_c039.c
@@ -20,6 +20,8 @@
 #include "test_c039.h"
 #include "test_data.h"
 
+#define PSA_KEY_LOCATION_RSS                ((psa_key_location_t) 0x800000)
+
 const client_test_t test_c039_crypto_list[] = {
     NULL,
     psa_asymmetric_encrypt_test,
@@ -62,6 +64,9 @@ int32_t psa_asymmetric_encrypt_test(caller_security_t caller __UNUSED)
         val->crypto_function(VAL_CRYPTO_SET_KEY_TYPE,        &attributes, check1[i].type);
         val->crypto_function(VAL_CRYPTO_SET_KEY_ALGORITHM,   &attributes, check1[i].alg);
         val->crypto_function(VAL_CRYPTO_SET_KEY_USAGE_FLAGS, &attributes, check1[i].usage_flags);
+        val->crypto_function(VAL_CRYPTO_SET_KEY_LIFETIME, &attributes, PSA_KEY_LIFETIME_FROM_PERSISTENCE_AND_LOCATION(PSA_KEY_PERSISTENCE_VOLATILE,
+                                                                       PSA_KEY_LOCATION_RSS));
+
 
         /* Import the key data into the key slot */
         status = val->crypto_function(VAL_CRYPTO_IMPORT_KEY, &attributes, check1[i].data,
