+        .function_id = MBEDTLS_CRYPTO_ASYMMETRIC_ENCRYPT_SID,
+        .key_id = key,
+        .alg = alg
+    };
+
+    /* Sanitize the optional input */
+    if ((salt == NULL) && (salt_length != 0)) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
+
+    struct psa_invec in_vec[] = {
+        {.base = &iov, .len = sizeof(struct mbedtls_crypto_pack_iovec)},
