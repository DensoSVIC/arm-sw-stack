+/*
+ * The attributes definitions are different between RSS and Mbedtls.
+ * This function converts Mbedtls attributes to RSS attributes.
+ */
+static void convert_to_rss_attr(
+    const psa_key_attributes_t *attributes,
+    struct psa_client_key_attributes_s *rss_attributes)
+{
+    rss_attributes->type = psa_get_key_type(attributes);
+    rss_attributes->bits = psa_get_key_bits(attributes);
+    /* The lifetime contains two information:
+     *   the upper 8-bits: key location
+     *   the lower 8-bits: persistence level
+     * For RSS, it doesn't need the location we set in the application.
+     * Set location to 0 and it will be handled locally.
+     */
+    rss_attributes->lifetime = psa_get_key_lifetime(attributes) & 0xff;
+    rss_attributes->usage = psa_get_key_usage_flags(attributes);
+    rss_attributes->alg = psa_get_key_algorithm(attributes);
+    rss_attributes->id = psa_get_key_id(attributes);
+}
