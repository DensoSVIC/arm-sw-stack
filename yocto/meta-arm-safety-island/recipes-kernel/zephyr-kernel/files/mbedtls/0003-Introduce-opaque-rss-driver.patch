+psa_status_t rss_opaque_import_key(
+    const psa_key_attributes_t *attributes,
+    const uint8_t *data,
+    size_t data_length,
+    uint8_t *key_buffer,
+    size_t key_buffer_size,
+    size_t *key_buffer_length,
+    size_t *bits)
+{
+    (void) key_buffer_length;
+    (void) bits;
+
+    struct mbedtls_crypto_pack_iovec iov = {
+        .function_id = MBEDTLS_CRYPTO_IMPORT_KEY_SID,
+    };
+
+    struct psa_client_key_attributes_s rss_attributes;
+    convert_to_rss_attr(attributes, &rss_attributes);
+
+    struct psa_invec in_vec[] = {
+        {.base = &iov, .len = sizeof(struct mbedtls_crypto_pack_iovec)},
+        {.base = &rss_attributes, .len = sizeof(struct psa_client_key_attributes_s)},
+        {.base = data, .len = data_length}
+    };
+
+    struct psa_outvec out_vec[] = {
+        {.base = key_buffer, .len = key_buffer_size}
+    };
+
+    return psa_call(PSA_CRYPTO_HANDLE, PSA_IPC_CALL,  \
+                    in_vec, IOVEC_LEN(in_vec),        \
+                    out_vec, IOVEC_LEN(out_vec));
+
+}
