+    /* Convert key id to key buffer */
+    rss_psa_key_id_t key = *(uint32_t *)key_buffer;
+
+    struct mbedtls_crypto_pack_iovec iov = {
+        .function_id = MBEDTLS_CRYPTO_ASYMMETRIC_DECRYPT_SID,
+        .key_id = key,
+        .alg = alg
+    };
+
+    /* Sanitize the optional input */
+    if ((salt == NULL) && (salt_length != 0)) {
+        return PSA_ERROR_INVALID_ARGUMENT;
+    }
