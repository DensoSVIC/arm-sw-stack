 enum xc_psr_cmt_type {
     XC_PSR_CMT_L3_OCCUPANCY,
     XC_PSR_CMT_TOTAL_MEM_COUNT,
@@ -2529,6 +2529,9 @@ int xc_psr_get_domain_data(xc_interface *xch, uint32_t domid,
