From 40762cdcdf5cc5cdf8ee65f982d335845948fcbd Mon Sep 17 00:00:00 2001
From: Anton Antonov <Anton.Antonov@arm.com>
Date: Thu, 7 Sep 2023 18:48:31 +0800
Subject: [PATCH] Bump ASN1 crates dependencies

picky-asn1 0.7.2 contains a fix for occasional incorrect ASN1 Integer builds:
https://github.com/Devolutions/picky-rs/pull/209

Signed-off-by: Anton Antonov <Anton.Antonov@arm.com>
Upstream-Status: Backport [https://github.com/parallaxsecond/parsec/pull/691]
---
 Cargo.lock | 60 +++++++++++++++++--------
 Cargo.toml |  6 +--
 2 files changed, 45 insertions(+), 21 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index d2397609..775b3c0b 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -95,9 +95,9 @@ checksum = "d468802bab17cbc0cc575e9b053f41e72aa36bfa6b7f55e3529ffa43161b97fa"
 
 [[package]]
