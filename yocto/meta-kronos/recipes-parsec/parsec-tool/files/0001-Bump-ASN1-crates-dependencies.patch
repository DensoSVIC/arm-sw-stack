From f76b1cb789534a7de8696b926b68b79608718d78 Mon Sep 17 00:00:00 2001
From: Anton Antonov <Anton.Antonov@arm.com>
Date: Mon, 21 Aug 2023 15:34:46 +0100
Subject: [PATCH] Bump ASN1 crates dependencies
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit
​
picky-asn1 0.7.2 contains a fix for occasional incorrect ASN1 Integer builds:
https://github.com/Devolutions/picky-rs/pull/209
​
Fixes: https://github.com/parallaxsecond/parsec-tool/issues/101
​
Signed-off-by: Anton Antonov <Anton.Antonov@arm.com>
Upstream-Status: Backport [https://github.com/parallaxsecond/parsec-tool/pull/102]
---
 Cargo.lock | 14 +++++++-------
 Cargo.toml |  6 +++---
 2 files changed, 10 insertions(+), 10 deletions(-)
​
diff --git a/Cargo.lock b/Cargo.lock
index ae39874..97189b7 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -856,9 +856,9 @@ checksum = "478c572c3d73181ff3c2539045f6eb99e5491218eae919370993b890cdbdd98e"
 
 [[package]]
 name = "picky-asn1"
-version = "0.3.3"
+version = "0.7.2"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "889bbb26c80acf919e89980dfc8e04eb19df272d8a9893ec9b748d3a1675abde"
+checksum = "6f338f1fd4f3e13e75e986ca29f2a3c62528d88d3cbadf4afdcefb6b087f2d32"
 dependencies = [
  "oid",
  "serde",
@@ -867,9 +867,9 @@ dependencies = [
 
 [[package]]
 name = "picky-asn1-der"
-version = "0.2.5"
+version = "0.4.0"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "acbbd5390ab967396cc7473e6e0848684aec7166e657c6088604e07b54a73dbe"
+checksum = "e47267a46f4ea246b772381970b8ed3f15963dd3e15ffc2c3f4ac3bc2d77384b"
 dependencies = [
  "picky-asn1",
  "serde",
@@ -878,11 +878,11 @@ dependencies = [
 
 [[package]]
 name = "picky-asn1-x509"
-version = "0.6.1"
+version = "0.11.0"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "f3033675030de806aba1d5470949701b7c9f1dbf77e3bb17bd12e5f945e560ba"
+checksum = "25c2718a5fe2b6c4b651bad5514699182f01db1b2f256fd6ab237f5879a01a4a"
 dependencies = [
- "base64 0.13.1",
+ "base64 0.21.0",
  "oid",
  "picky-asn1",
  "picky-asn1-der",
diff --git a/Cargo.toml b/Cargo.toml
index 9eb4b74..348df75 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -22,9 +22,9 @@ env_logger = "0.8.2"
 oid = { version = "0.2", features = ["serde_support"] }
 pem = "1.1.0"
 base64 = "0.13.0"
-picky-asn1 = "0.3.0"
-picky-asn1-der = "0.2.4"
-picky-asn1-x509 = "0.6.1"
+picky-asn1 = "0.7.2"
+picky-asn1-der = "0.4.0"
+picky-asn1-x509 = "0.11.0"
 serde = "1.0.123"
 sha2 = "0.9.9"
 log = "0.4.14"
-- 
2.25.1
