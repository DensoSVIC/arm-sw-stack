+    cur_typer = readq_relaxed(cur_its->its_base + GITS_TYPER);
+    if ( !FIELD_GET(GITS_TYPER_SVPET, cur_typer) )
+        return NULL;
+
+    aff = compute_its_aff(cur_its);
+
+    list_for_each_entry(its, &host_its_list, entry)
+    {
+        uint64_t typer, baser;
