+    dev->itt_addr = itt_addr;
+    dev->hw_its = hw_its;
+    dev->host_devid = host_devid;
+    dev->eventids = nr_events;
+
+    return dev;
+
+ fail_dev:
+    xfree(dev);
+ fail_itt:
+    xfree(itt_addr);
+
+    return NULL;
