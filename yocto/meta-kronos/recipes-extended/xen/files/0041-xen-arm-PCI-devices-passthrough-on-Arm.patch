diff --git a/xen/drivers/vpci/arm_msix.c b/xen/drivers/vpci/arm_msix.c
new file mode 100644
index 0000000000..858bb7eb84
--- /dev/null
+++ b/xen/drivers/vpci/arm_msix.c
@@ -0,0 +1,108 @@
+/*
