From 77c11a8663894fdcfda85afe6746bf356dffb46b Mon Sep 17 00:00:00 2001
From: Henry Wang <Henry.Wang@arm.com>
Date: Tue, 1 Mar 2022 07:37:32 +0000
Subject: [PATCH] xen/arm: Context switch MPAM system registers between vCPUs

According to MPAM specification, software assigns VMs and applications
to a partition. The hypervisor can assign VMs to partitions. A memory
system partition is associated with a software environment on a PE by
loading an MPAMn_ELx register with PARTID_I and PARTID_D. When Xen
needs to partition the resource of a specific VM, it needs to limit
the VM both in EL1 and EL0.

Hence, this commit firstly adds the MPAM0_EL1 and MPAM1_EL1 registers
to struct arch_vcpu and then adds code related context switching these
registers between vCPUs.

Signed-off-by: Henry Wang <Henry.Wang@arm.com>
Upstream-Status: Pending
Issue-Id: SCM-3395
---
 xen/arch/arm/domain.c             | 11 +++++++++++
 xen/arch/arm/include/asm/domain.h |  4 ++++
 xen/arch/arm/include/asm/mpam.h   |  2 ++
 xen/arch/arm/mpam.c               | 19 +++++++++++++++++++
 4 files changed, 36 insertions(+)

diff --git a/xen/arch/arm/domain.c b/xen/arch/arm/domain.c
index 1d5a2e7abd08..6bcbdc2c5dc4 100644
--- a/xen/arch/arm/domain.c
+++ b/xen/arch/arm/domain.c
@@ -21,6 +21,7 @@
 #include <asm/gic.h>
 #include <asm/guest_atomics.h>
 #include <asm/irq.h>
+#include <asm/mpam.h>
 #include <asm/p2m.h>
 #include <asm/platform.h>
 #include <asm/procinfo.h>
@@ -162,6 +163,10 @@ static void ctxt_switch_from(struct vcpu *p)
     /* VGIC */
     gic_save_state(p);
 
+#ifdef CONFIG_MPAM
+    mpam_save_state(p);
+#endif
+
     isb();
 }
 
@@ -276,6 +281,12 @@ static void ctxt_switch_to(struct vcpu *n)
     virt_timer_restore(n);
 
     WRITE_SYSREG(n->arch.mdcr_el2, MDCR_EL2);
+
+#ifdef CONFIG_MPAM
+    mpam_restore_state(n);
+#endif
+
+    isb();
 }
 
 static void schedule_tail(struct vcpu *prev)
diff --git a/xen/arch/arm/include/asm/domain.h b/xen/arch/arm/include/asm/domain.h
index 1d0e46adc5ec..2a2532ec0238 100644
--- a/xen/arch/arm/include/asm/domain.h
+++ b/xen/arch/arm/include/asm/domain.h
@@ -246,6 +246,10 @@ struct arch_vcpu
      */
     bool need_flush_to_ram;
 
+#ifdef CONFIG_MPAM
+    uint64_t mpam0_el1;
+    uint64_t mpam1_el1;
+#endif
 }  __cacheline_aligned;
 
 void vcpu_show_registers(const struct vcpu *);
diff --git a/xen/arch/arm/include/asm/mpam.h b/xen/arch/arm/include/asm/mpam.h
index 24ff85b22491..78d1f5d7c6c2 100644
--- a/xen/arch/arm/include/asm/mpam.h
+++ b/xen/arch/arm/include/asm/mpam.h
@@ -413,6 +413,8 @@ extern bool mpam_enabled;
 
 extern void mpam_postsmp_setup(void);
 extern void mpam_presmp_setup(void);
+extern void mpam_restore_state(struct vcpu *n);
+extern void mpam_save_state(struct vcpu *n);
 extern void mpam_sanitise_config(struct xen_arch_domctl_mpam *cfg,
                                  bool domain_create);
 extern void mpam_update_domain(struct domain *d);
diff --git a/xen/arch/arm/mpam.c b/xen/arch/arm/mpam.c
index 606a8ae20b25..7d466c2f1fe4 100644
--- a/xen/arch/arm/mpam.c
+++ b/xen/arch/arm/mpam.c
@@ -23,6 +23,7 @@
 #include <xen/device_tree.h>
 #include <xen/err.h>
 #include <xen/param.h>
+#include <xen/sched.h>
 #include <xen/string.h>
 #include <xen/vmap.h>
 #include <asm/io.h>
@@ -1455,6 +1456,24 @@ int __init mpam_discovery_cpu_online(unsigned int cpu)
     return 0;
 }
 
+void mpam_save_state(struct vcpu *n)
+{
+    if ( !mpam_enabled )
+        return;
+
+    n->arch.mpam0_el1 = READ_SYSREG(MPAM0_EL1);
+    n->arch.mpam1_el1 = READ_SYSREG(MPAM1_EL1);
+}
+
+void mpam_restore_state(struct vcpu *n)
+{
+    if ( !mpam_enabled )
+        return;
+
+    WRITE_SYSREG(n->arch.mpam0_el1, MPAM0_EL1);
+    WRITE_SYSREG(n->arch.mpam1_el1, MPAM1_EL1);
+}
+
 /*
  * Local variables:
  * mode: C
-- 
2.34.1

