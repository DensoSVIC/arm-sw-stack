From 07868e0f91d7b12fa4ff7d508c99d35f9170b738 Mon Sep 17 00:00:00 2001
From: Henry Wang <Henry.Wang@arm.com>
Date: Thu, 23 Jun 2022 09:52:24 +0000
Subject: [PATCH] xen/arm: Return correct cores_per_socket value in
 XEN_SYSCTL_physinfo

In the common sysctl command XEN_SYSCTL_physinfo, the cores_per_socket
is calculated based on the cpu_core_mask of CPU0. Currently on Arm
this is a fixed value 1 (can be checked via xl info), which is not
correct. This is because during the Arm cpu online process,
set_cpu_sibling_map() only sets the per cpu cpu_core_mask for itself.

Considering Arm does not support NUMA and CPU hotplug for now, this
commit adds each cpu to the cpu_core_mask of CPU0 to make sure the
correct cores_per_socket can be returned from XEN_SYSCTL_physinfo.

Signed-off-by: Henry Wang <Henry.Wang@arm.com>
Upstream-Status: Pending
---
 xen/arch/arm/smpboot.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/xen/arch/arm/smpboot.c b/xen/arch/arm/smpboot.c
index b3fc0b8a4b..91804af5a4 100644
--- a/xen/arch/arm/smpboot.c
+++ b/xen/arch/arm/smpboot.c
@@ -94,6 +94,8 @@ static int setup_cpu_sibling_map(int cpu)
     cpumask_set_cpu(cpu, per_cpu(cpu_sibling_mask, cpu));
     cpumask_set_cpu(cpu, per_cpu(cpu_core_mask, cpu));
 
+    cpumask_set_cpu(cpu, per_cpu(cpu_core_mask, 0));
+
     return 0;
 }
 
