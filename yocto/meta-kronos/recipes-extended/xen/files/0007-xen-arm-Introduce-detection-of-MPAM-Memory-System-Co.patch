diff --git a/xen/arch/arm/setup.c b/xen/arch/arm/setup.c
index cc52a4e17a..7818f5b274 100644
--- a/xen/arch/arm/setup.c
+++ b/xen/arch/arm/setup.c
@@ -53,6 +53,7 @@
 #include <asm/setup.h>
 #include <xsm/xsm.h>
 #include <asm/acpi.h>
+#include <asm/mpam.h>
 
 struct bootinfo __initdata bootinfo;
 
@@ -947,6 +948,10 @@ void __init start_xen(unsigned long boot_phys_offset,
     printk(XENLOG_INFO "SMP: Allowing %u CPUs\n", cpus);
     nr_cpu_ids = cpus;
 
+#ifdef CONFIG_MPAM
+    mpam_presmp_setup();
+#endif
+
     /*
      * Some errata relies on SMCCC version which is detected by psci_init()
      * (called from smp_init_cpus()).
diff --git a/xen/include/asm-arm/mpam.h b/xen/include/asm-arm/mpam.h
new file mode 100644
index 0000000000..1a5f8b20fa
--- /dev/null
+++ b/xen/include/asm-arm/mpam.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (C) 2022 Arm Ltd.
+ */
+
+#ifndef __ARM_MPAM_H__
+#define __ARM_MPAM_H__
+
+#include <asm/cpufeature.h>
+
+extern void mpam_presmp_setup(void);
+
+#endif /* __ARM_MPAM_H__ */
+
