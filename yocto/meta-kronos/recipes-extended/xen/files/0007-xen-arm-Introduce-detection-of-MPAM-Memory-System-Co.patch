+ */
+
+#include <xen/device_tree.h>
+#include <xen/err.h>
+#include <asm/mpam.h>
+
+static int __init mpam_dt_count_msc(void)
+{
+    int count = 0;
+    const struct dt_device_node *node;
+
+    dt_for_each_device_node(dt_host, node)
+    {
+        if ( dt_device_is_compatible(node, "arm,mpam-msc") )
+            count++;
+    }
+
+    return count;
+}
+
+static int __init mpam_msc_probe(void)
+{
+    unsigned int num_msc = 0;
+
+    if ( !cpu_has_mpam )
+    {
+        printk(XENLOG_ERR "MPAM: MPAM is not supported in system\n");
+        return -EOPNOTSUPP;
+    }
+
+    num_msc = mpam_dt_count_msc();
+    printk(XENLOG_INFO "MPAM: Probed %d MSC from firmware\n",
+           num_msc);
+
+    if ( !num_msc )
+        return -EINVAL;
+
+    return 0;
+}
+
+void __init mpam_presmp_setup(void)
+{
+    int rc = 0;
+
+    rc = mpam_msc_probe();
+    if ( rc )
+    {
+        printk(XENLOG_WARNING
+               "MPAM: Skip MPAM pre-smp setup due to %s failure, rc: %d\n",
+               __func__, rc);
+        return;
+    }
+}
+
+/*
+ * Local variables:
+ * mode: C
+ * c-file-style: "BSD"
+ * c-basic-offset: 4
+ * indent-tabs-mode: nil
+ * End:
