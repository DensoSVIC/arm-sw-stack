From f6c15cfc6fe1b48dd424f9233d8633cac84cbfc5 Mon Sep 17 00:00:00 2001
From: Luca Fancellu <luca.fancellu@arm.com>
Date: Fri, 3 Mar 2023 14:23:31 +0000
Subject: [PATCH] mailbox: Patch MHUv2 driver to make it work with MHUv3

Signed-off-by: Yanqin Wei <Yanqin.Wei@arm.com>
Signed-off-by: Luca Fancellu <luca.fancellu@arm.com>
Upstream-Status: Inappropriate
---
 drivers/mailbox/arm_mhuv2.c | 37 ++++++++++++++-----------------------
 1 file changed, 14 insertions(+), 23 deletions(-)

diff --git a/drivers/mailbox/arm_mhuv2.c b/drivers/mailbox/arm_mhuv2.c
index c6d4957c4da8..bfc160763940 100644
--- a/drivers/mailbox/arm_mhuv2.c
+++ b/drivers/mailbox/arm_mhuv2.c
@@ -545,7 +545,7 @@ static irqreturn_t mhuv2_sender_interrupt(int irq, void *data)
 	int i, found = 0;
 	u32 stat;
 
-	chan = get_irq_chan_comb(mhu, mhu->send->chcomb_int_st);
+	chan = get_irq_chan_comb(mhu, (u32*) (((void*)mhu->send) - 0x1000 + 0x400));
 	if (IS_ERR(chan)) {
 		dev_warn(dev, "Failed to find channel for the Tx interrupt\n");
 		return IRQ_NONE;
@@ -623,7 +623,7 @@ static struct mbox_chan *get_irq_chan_comb_rx(struct mhuv2 *mhu)
 	struct mbox_chan *chan;
 	u32 stat;
 
-	chan = get_irq_chan_comb(mhu, mhu->recv->chcomb_int_st);
+	chan = get_irq_chan_comb(mhu, (u32*)(    ((void*)mhu->recv) - 0x1000 + 0x400));
 	if (IS_ERR(chan))
 		return chan;
 
@@ -675,8 +675,8 @@ static struct mbox_chan *get_irq_chan_rx(struct mhuv2 *mhu)
 static irqreturn_t mhuv2_receiver_interrupt(int irq, void *arg)
 {
 	struct mhuv2 *mhu = arg;
-	struct mbox_chan *chan = get_irq_chan_rx(mhu);
 	struct device *dev = mhu->mbox.dev;
+	struct mbox_chan *chan = get_irq_chan_rx(mhu);
 	struct mhuv2_mbox_chan_priv *priv;
 	int ret = IRQ_NONE;
 	void *data;
@@ -970,10 +970,10 @@ static int mhuv2_tx_init(struct amba_device *adev, struct mhuv2 *mhu,
 
 	mhu->frame = SENDER_FRAME;
 	mhu->mbox.ops = &mhuv2_sender_ops;
-	mhu->send = reg;
+	mhu->send = reg + 0x1000;
 
-	mhu->windows = readl_relaxed_bitfield(&mhu->send->mhu_cfg, struct mhu_cfg_t, num_ch);
-	mhu->minor = readl_relaxed_bitfield(&mhu->send->aidr, struct aidr_t, arch_minor_rev);
+	mhu->windows = 1;
+	mhu->minor = 1;
 
 	spin_lock_init(&mhu->doorbell_pending_lock);
 
@@ -993,8 +993,6 @@ static int mhuv2_tx_init(struct amba_device *adev, struct mhuv2 *mhu,
 			mhu->mbox.txdone_poll = false;
 			mhu->irq = adev->irq[0];
 
-			writel_relaxed_bitfield(1, &mhu->send->int_en, struct int_en_t, chcomb);
-
 			/* Disable all channel interrupts */
 			for (i = 0; i < mhu->windows; i++)
 				writel_relaxed(0x0, &mhu->send->ch_wn[i].int_en);
@@ -1008,10 +1006,6 @@ static int mhuv2_tx_init(struct amba_device *adev, struct mhuv2 *mhu,
 	mhu->mbox.txpoll_period = 1;
 
 out:
-	/* Wait for receiver to be ready */
-	writel_relaxed(0x1, &mhu->send->access_request);
-	while (!readl_relaxed(&mhu->send->access_ready))
-		continue;
 
 	return 0;
 }
@@ -1024,10 +1018,10 @@ static int mhuv2_rx_init(struct amba_device *adev, struct mhuv2 *mhu,
 
 	mhu->frame = RECEIVER_FRAME;
 	mhu->mbox.ops = &mhuv2_receiver_ops;
-	mhu->recv = reg;
+	mhu->recv = reg + 0x1000;
 
-	mhu->windows = readl_relaxed_bitfield(&mhu->recv->mhu_cfg, struct mhu_cfg_t, num_ch);
-	mhu->minor = readl_relaxed_bitfield(&mhu->recv->aidr, struct aidr_t, arch_minor_rev);
+	mhu->windows = 1;
+	mhu->minor = 1;
 
 	mhu->irq = adev->irq[0];
 	if (!mhu->irq) {
@@ -1047,9 +1041,6 @@ static int mhuv2_rx_init(struct amba_device *adev, struct mhuv2 *mhu,
 	for (i = 0; i < mhu->windows; i++)
 		writel_relaxed(0xFFFFFFFF, &mhu->recv->ch_wn[i].mask_set);
 
-	if (mhu->minor)
-		writel_relaxed_bitfield(1, &mhu->recv->int_en, struct int_en_t, chcomb);
-
 	return 0;
 }
 
@@ -1060,10 +1051,14 @@ static int mhuv2_probe(struct amba_device *adev, const struct amba_id *id)
 	struct mhuv2 *mhu;
 	void __iomem *reg;
 	int ret = -EINVAL;
+	resource_size_t tmp_size;
+	u32 iidr, aidr;
 
-	reg = devm_of_iomap(dev, dev->of_node, 0, NULL);
+	reg = devm_of_iomap(dev, dev->of_node, 0, &tmp_size);
 	if (IS_ERR(reg))
 		return PTR_ERR(reg);
+	iidr = readl_relaxed(reg + 0xFC8);
+	aidr = readl_relaxed(reg + 0xFCC);
 
 	mhu = devm_kzalloc(dev, sizeof(*mhu), GFP_KERNEL);
 	if (!mhu)
@@ -1100,10 +1095,6 @@ static int mhuv2_probe(struct amba_device *adev, const struct amba_id *id)
 
 static void mhuv2_remove(struct amba_device *adev)
 {
-	struct mhuv2 *mhu = amba_get_drvdata(adev);
-
-	if (mhu->frame == SENDER_FRAME)
-		writel_relaxed(0x0, &mhu->send->access_request);
 }
 
 static struct amba_id mhuv2_ids[] = {
-- 
2.34.1

