 static bool tcp_server_running;
 static bool tcp_server_stop;
 static uint16_t tcp_server_port;
+static struct in6_addr tcp_server_in6_addr;    /* IPv6 address */
+static struct in_addr tcp_server_in_addr;      /* IPv4 address */
 static K_SEM_DEFINE(tcp_server_run, 0, 1);
 
 static int tcp_bind_listen_connection(struct zsock_pollfd *pollfd,
@@ -153,26 +155,8 @@ static void tcp_server_session(void)
 			goto error;
 		}
 
-		if (MY_IP4ADDR && strlen(MY_IP4ADDR)) {
-			/* Use Setting IP */
-			ret = zperf_get_ipv4_addr(MY_IP4ADDR,
-						  &in4_addr->sin_addr);
-			if (ret < 0) {
-				NET_WARN("Unable to set IPv4");
-				goto use_existing_ipv4;
-			}
-		} else {
-		use_existing_ipv4:
-			/* Use existing IP */
-			const struct in_addr *addr =
-				zperf_get_default_if_in4_addr();
-			if (!addr) {
-				NET_ERR("Unable to get IPv4 by default");
-				goto error;
-			}
-			memcpy(&in4_addr->sin_addr, addr,
-				sizeof(struct in_addr));
-		}
+		memcpy(&in4_addr->sin_addr, &tcp_server_in_addr,
+		       sizeof(struct in_addr));
 
 		in4_addr->sin_port = htons(tcp_server_port);
 
@@ -201,27 +185,8 @@ static void tcp_server_session(void)
 			goto error;
 		}
 
-		if (MY_IP6ADDR && strlen(MY_IP6ADDR)) {
-			/* Use Setting IP */
-			ret = zperf_get_ipv6_addr(MY_IP6ADDR,
-						  MY_PREFIX_LEN_STR,
-						  &in6_addr->sin6_addr);
-			if (ret < 0) {
-				NET_WARN("Unable to set IPv6");
-				goto use_existing_ipv6;
-			}
-		} else {
-		use_existing_ipv6:
-			/* Use existing IP */
-			const struct in6_addr *addr =
-				zperf_get_default_if_in6_addr();
-			if (!addr) {
-				NET_ERR("Unable to get IPv4 by default");
-				goto error;
-			}
-			memcpy(&in6_addr->sin6_addr, addr,
-				sizeof(struct in6_addr));
-		}
+		memcpy(&in6_addr->sin6_addr, &tcp_server_in6_addr,
+		       sizeof(struct in6_addr));
 
 		in6_addr->sin6_port = htons(tcp_server_port);
 
@@ -386,6 +351,10 @@ int zperf_tcp_download(const struct zperf_download_params *param,
 		return -EALREADY;
 	}
 
+	memcpy(&tcp_server_in_addr, &param->sin_addr,
+	       sizeof(struct in_addr));
+	memcpy(&tcp_server_in6_addr, &param->sin6_addr,
+	       sizeof(struct in6_addr));
 	tcp_session_cb = callback;
 	tcp_user_data = user_data;
 	tcp_server_port = param->port;
diff --git a/subsys/net/lib/zperf/zperf_udp_receiver.c b/subsys/net/lib/zperf/zperf_udp_receiver.c
