# Interface for communication with the Safety Island Cluster 2
auto ethsi2
iface ethsi2 inet static
    address 192.168.2.2
    netmask 255.255.255.0
    pre-up ip link set eth3 name ethsi2
    post-down ip link set ethsi2 name eth3
