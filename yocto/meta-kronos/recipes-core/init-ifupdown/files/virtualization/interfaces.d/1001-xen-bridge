# Xen bridge external interface
auto brext0
iface brext0 inet dhcp
    pre-up brctl addbr brext0
    pre-up brctl addif brext0 eth0
    post-down brctl delbr brext0

# Xen bridge SI Cl0 interface
auto brsi0
iface brsi0 inet static
    pre-up brctl addbr brsi0
    pre-up brctl addif brsi0 ethsi0
    post-down brctl delbr brsi0
    address 192.168.0.254
    netmask 255.255.255.0

# Xen bridge SI Cl1 interface
auto brsi1
iface brsi1 inet static
    pre-up brctl addbr brsi1
    pre-up brctl addif brsi1 ethsi1
    post-down brctl delbr brsi1
    address 192.168.1.254
    netmask 255.255.255.0

# Xen bridge SI Cl2 interface
auto brsi2
iface brsi2 inet static
    pre-up brctl addbr brsi2
    pre-up brctl addif brsi2 ethsi2
    post-down brctl delbr brsi2
    address 192.168.2.254
    netmask 255.255.255.0
